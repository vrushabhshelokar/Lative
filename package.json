{
  "name": "lative",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Privacy-first local career assistant browser extension",
  "scripts": {
    "dev": "vite",
    "build:chrome": "tsc && vite build",
    "build:firefox": "tsc && vite build --mode firefox && node -e \"require('fs').copyFileSync('manifests/manifest.firefox.json', 'dist-firefox/manifest.json')\"",
    "build": "npm run build:chrome && npm run build:firefox",
    "zip:chrome": "powershell -Command \"Compress-Archive -Path dist\\* -DestinationPath lative-chrome-v1.0.0.zip -Force\"",
    "zip:firefox": "powershell -Command \"Compress-Archive -Path dist-firefox\\* -DestinationPath lative-firefox-v1.0.0.zip -Force\"",
    "zip": "npm run zip:chrome && npm run zip:firefox",
    "release": "npm run build && npm run zip",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@eslint/js": "^9.14.0",
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.10"
  }
}
